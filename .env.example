# Neon Postgres — copy the pooled connection string from the Neon dashboard.
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/ssj?sslmode=require

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

PORT=5000
NODE_ENV=development

# Comma-separated browser origins allowed to call this API with credentials.
CORS_ORIGINS=http://localhost:3000

BCRYPT_ROUNDS=12
