# Neon Postgres — copy the pooled connection string from the Neon dashboard.
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/ssj?sslmode=require

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me-too
JWT_ACCESS_TTL=1d
JWT_REFRESH_TTL=7d

PORT=5000
NODE_ENV=development

# Comma-separated browser origins allowed to call this API with credentials.
# No trailing slashes. To allow both local dev and the deployed frontend:
# CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:3000

BCRYPT_ROUNDS=12

# Max upload size for /api/v1/uploads (registration attachments, team
# photos, ad creatives, blog cover images, event images).
MAX_UPLOAD_MB=8

# Cloudinary — required for /api/v1/uploads. Copy from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# Password reset emails. The reset link points at the admin panel (ADMIN_URL).
# Leave SMTP_HOST blank in development to print the link to the server log.
ADMIN_URL=http://localhost:5173
# The public website; signup and welcome emails link back to it. Use https://www.shyamjagat.com in production.
SITE_URL=http://localhost:3000
PASSWORD_RESET_TTL_MINUTES=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Shyam Jagat <no-reply@shyamjagat.com>

# Razorpay (registration fee). Test keys (rzp_test_...) move no money; live keys (rzp_live_...) do.
# RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET: from Account & Settings > API Keys. The secret is shown only once.
# RAZORPAY_WEBHOOK_SECRET: a long random string, the same one typed into the Razorpay webhook (URL: /api/v1/payments/webhook).
# RAZORPAY_MAX_ORDER_AMOUNT: the largest single payment the account allows, in rupees (default 500000).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_MAX_ORDER_AMOUNT=500000

# Phone verification (one-time codes by text message).
#   SMS_PROVIDER=msg91    send through MSG91 (production). Needs the two MSG91 values below.
#   SMS_PROVIDER=console  print the code in the server log (local development).
#   leave blank           phone verification is off ("not switched on yet").
# In India a text is only delivered if the sender ID and message template are registered on DLT.
SMS_PROVIDER=
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# Sign in with Google: the OAuth Web client id from Google Cloud (ends in .apps.googleusercontent.com). It is public;
# no client secret is needed. The site needs the same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=751051334242-94j672ue7ki6vumlah4f6rotn5d4hhaf.apps.googleusercontent.com
