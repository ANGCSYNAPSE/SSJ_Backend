# Neon Postgres — copy the pooled connection string from the Neon dashboard.
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/ssj?sslmode=require

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me
JWT_REFRESH_SECRET=replace-me-too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

PORT=5000
NODE_ENV=development

# Comma-separated browser origins allowed to call this API with credentials.
# No trailing slashes. To allow both local dev and the deployed frontend:
# CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:3000

BCRYPT_ROUNDS=12

# Max upload size for /api/v1/uploads (registration attachments, team
# photos, ad creatives, blog cover images, event images).
MAX_UPLOAD_MB=8

# Cloudinary — required for /api/v1/uploads. Copy from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# Razorpay — required for /api/v1/donations/create-order, /verify and /webhook.
RAZORPAY_KEY_ID=replace-me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me
RAZORPAY_API_BASE=https://api.razorpay.com/v1
